from kivy.app import App
from kivy.uix.screenmanager import ScreenManager, Screen
from kivy.uix.boxlayout import BoxLayout
from kivy.uix.button import Button

class HomeScreen(Screen):
    pass

class ShopScreen(Screen):
    pass

class ItemsScreen(Screen):
    pass

class MainApp(App):
    def build(self):
        # 1. 创建屏幕管理器
        sm = ScreenManager()
        sm.add_widget(HomeScreen(name='home'))
        sm.add_widget(ShopScreen(name='shop'))
        sm.add_widget(ItemsScreen(name='items'))

        # 2. 创建底部导航栏布局
        nav_layout = BoxLayout(orientation='horizontal', size_hint=(1, 0.1))
        btn_home = Button(text='首页')
        btn_shop = Button(text='商店')
        btn_items = Button(text='物品')

        # 3. 绑定按钮点击事件，切换屏幕
        btn_home.bind(on_press=lambda x: setattr(sm, 'current', 'home'))
        btn_shop.bind(on_press=lambda x: setattr(sm, 'current', 'shop'))
        btn_items.bind(on_press=lambda x: setattr(sm, 'current', 'items'))

        nav_layout.add_widget(btn_home)
        nav_layout.add_widget(btn_shop)
        nav_layout.add_widget(btn_items)

        # 4. 将导航栏和屏幕管理器组合到主布局
        main_layout = BoxLayout(orientation='vertical')
        main_layout.add_widget(sm)  # 屏幕内容占大部分空间
        main_layout.add_widget(nav_layout)  # 底部导航栏

        return main_layout

if __name__ == '__main__':
    MainApp().run()
